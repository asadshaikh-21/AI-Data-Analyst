# Pick ONE provider. With no key set the app runs in offline heuristic mode.
LLM_PROVIDER=auto            # auto | anthropic | openai | offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

MAX_UPLOAD_MB=25
QUERY_TIMEOUT_S=15
LOG_LEVEL=INFO
